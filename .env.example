# Optional. The demo works fully without any of these.
# Copy to .env.local to enable live AI extraction for pasted/uploaded notices.
# Everything here is read on the server only. Never prefix these with NEXT_PUBLIC_.

# Which extraction backend to use:
#   (unset)     -> "anthropic" if ANTHROPIC_API_KEY is set, otherwise AI is off
#   anthropic   -> Anthropic API via the SDK (needs ANTHROPIC_API_KEY)
#   claude-cli  -> your local Claude Code CLI (`claude -p`), using its own login
#   codex-cli   -> your local Codex CLI (`codex exec`), using its own login
#   none        -> AI off
# The CLI backends only run on a local dev server (NODE_ENV !== "production")
# unless ALLOW_LOCAL_CLI_EXTRACTOR=1 is also set.
EXTRACTOR=

# anthropic backend
ANTHROPIC_API_KEY=
# Optional model override. Defaults to the value in lib/claude-extractor.ts.
ANTHROPIC_MODEL=

# claude-cli backend: optional model alias or full name (e.g. sonnet). Unset uses the CLI default.
CLAUDE_CLI_MODEL=

# codex-cli backend: optional model name passed to `codex exec -m`. Unset uses the CLI default.
CODEX_CLI_MODEL=

# Set to 1 to allow the CLI backends under `npm start` (production mode) on your own machine.
# Never set this on a shared or deployed server.
ALLOW_LOCAL_CLI_EXTRACTOR=
